# These MUST be set before admin can be used
SESSION_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHAR_SECRET
ADMIN_USERNAME=owner
ADMIN_PASSWORD_HASH=

# Never turn on before manager consent/acceptance, secure delivery,
# business policy review and successful Stripe test-mode checks
OPERATING_LIVE=false
SESSION_HTTPS=false
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Add through your hosting provider secret store, not in the code
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CENTS=2499
DATA_RETENTION_DAYS=90

# Remote database (Turso Free). Leave both empty to use the local SQLite
# file; set both to use Turso. Set them in the hosting provider secret
# store, never commit real values here.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
